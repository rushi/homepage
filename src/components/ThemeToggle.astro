---
// Renders both glyphs; CSS shows whichever matches the resolved theme.
---

<button class="themetoggle" id="themetoggle" type="button" aria-label="Switch theme" title="Switch theme">
  <svg class="themetoggle__sun" width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
    <circle cx="8" cy="8" r="3.1" stroke="currentColor" stroke-width="1.4"></circle>
    <path
      d="M8 1.4v1.5M8 13.1v1.5M14.6 8h-1.5M2.9 8H1.4M12.67 3.33l-1.06 1.06M4.39 11.61l-1.06 1.06M12.67 12.67l-1.06-1.06M4.39 4.39 3.33 3.33"
      stroke="currentColor"
      stroke-width="1.4"
      stroke-linecap="round"
    ></path>
  </svg>
  <svg class="themetoggle__moon" width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
    <path
      d="M13.5 9.6A5.8 5.8 0 0 1 6.4 2.5a5.8 5.8 0 1 0 7.1 7.1Z"
      stroke="currentColor"
      stroke-width="1.4"
      stroke-linejoin="round"
    ></path>
  </svg>
</button>
