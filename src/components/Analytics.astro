---
// Ported from the previous site (commit 6e841c5). Skipped on dev builds so local
// page views never reach the property.
interface Props {
  measurementId: string;
}

const { measurementId } = Astro.props;
const enabled = import.meta.env.PROD && measurementId.length > 0;
---

{enabled && (
  <>
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${measurementId}`}></script>
    <script is:inline define:vars={{ measurementId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", measurementId);
    </script>
  </>
)}
